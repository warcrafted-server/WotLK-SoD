########################################
# mod-sod-world configuration
########################################
#
#    SodWorld.Enable
#        Description: Master switch for the module. When disabled, the shared
#                     Season of Discovery encounters are inert (the Decrepit
#                     Phylactery summons nothing). The DB rows remain but the
#                     module-scripted behavior is a no-op.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

SodWorld.Enable = 1

#
#    SodWorld.AwakenedLich.DespawnSeconds
#        Description: How long the summoned Awakened Lich lingers before it
#                     despawns if not killed (the summon is also removed on
#                     death). Lower values make the encounter resettable sooner.
#        Default:     300 - (5 minutes)
#

SodWorld.AwakenedLich.DespawnSeconds = 300

#
#    SodWorld.AwakenedLich.Level
#        Description: Level the summoned Awakened Lich spawns at. Its health, mana,
#                     and damage scale from this level (via the creature template's
#                     stat modifiers). Applied to the next summon after a change;
#                     `.reload config` is enough -- no restart.
#        Default:     25
#

SodWorld.AwakenedLich.Level = 25

#
#    SodWorld.Phylactery.SummonRange
#        Description: How close (yards) the player must be to the Slumbering
#                     Bones to use the Decrepit Phylactery and summon the Lich.
#        Default:     10
#

SodWorld.Phylactery.SummonRange = 10

#
#    SodWorld.SupplyDrop.P{1..4}Chance
#        Description: Percent chance for a "Supply Shipment" crate to drop when a
#                     player opens one of the SoD world chests wired up for that
#                     phase (P1 item level 10, P2 25, P3 40, P4 50). These tune the
#                     Chance of the loot rows seeded by sod_world_supply_drops.sql;
#                     applied at startup and on `.reload config`. 0 disables that
#                     tier's drop. When SodWorld.Enable = 0 all four are forced to 0.
#        Default:     P1 10, P2 10, P3 10, P4 5
#

SodWorld.SupplyDrop.P1Chance = 10
SodWorld.SupplyDrop.P2Chance = 10
SodWorld.SupplyDrop.P3Chance = 10
SodWorld.SupplyDrop.P4Chance = 5

###############################################################################
# DRUID
###############################################################################
#
#    SodDruid.Enable
#        Description: Master switch for the custom Druid rune scripts.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

SodDruid.Enable = 1

#
#    SodDruid.Mangle.*
#        BearRageCost is whole Rage (stored internally in tenths).
#        CatEnergyCost uses the WotLK rank-6 Mangle (Cat) baseline.
#        DamagePct and BleedDamagePct tune the two SoD Mangle effects.
#        DefenseSkillPerLevel and AttackPowerPerDefense tune Bear Mangle's
#        Defender's Resolve bonus. BuffDurationSeconds sets the debuff and bonus
#        aura duration.
#
#        Defaults: BearRageCost 15, CatEnergyCost 45, DamagePct 160,
#                  BleedDamagePct 30, DefenseSkillPerLevel 5,
#                  AttackPowerPerDefense 4, BuffDurationSeconds 60
#

SodDruid.Mangle.BearRageCost = 15
SodDruid.Mangle.CatEnergyCost = 45
SodDruid.Mangle.DamagePct = 160
SodDruid.Mangle.BleedDamagePct = 30
SodDruid.Mangle.DefenseSkillPerLevel = 5
SodDruid.Mangle.AttackPowerPerDefense = 4
SodDruid.Mangle.BuffDurationSeconds = 60

#
#    SodDruid.Gore.*
#        ProcChance is the chance on eligible feral hits. RageAmount is whole Rage.
#        Defaults: ProcChance 15, RageAmount 10
#

SodDruid.Gore.ProcChance = 15
SodDruid.Gore.RageAmount = 10

#
#    SodDruid.WildStrikes.*
#        RadiusYards is based on the SoD radius index; RefreshMs controls how often
#        nearby group members are refreshed. The buff duration must be longer than
#        the refresh interval.
#        ProcChance, ProcCooldownMs, and AttackPowerPct tune the extra-attack proc.
#        Defaults: RadiusYards 100, RefreshMs 5000, BuffDurationSeconds 6,
#                  ProcChance 20, ProcCooldownMs 1500, AttackPowerPct 20
#

SodDruid.WildStrikes.RadiusYards = 100
SodDruid.WildStrikes.RefreshMs = 5000
SodDruid.WildStrikes.BuffDurationSeconds = 6
SodDruid.WildStrikes.ProcChance = 20
SodDruid.WildStrikes.ProcCooldownMs = 1500
SodDruid.WildStrikes.AttackPowerPct = 20

#
#    SodDruid.KingOfTheJungle.*
#        DamagePct, Energy, BuffDurationSeconds, and CooldownSeconds tune the
#        Tiger's Fury changes. FormCheckMs controls how quickly Bear forms cancel it.
#        Energy is the total target including the core WotLK talent grant; values
#        below that grant cannot reduce the energy from the core talent script.
#        Defaults: DamagePct 15, Energy 60, BuffDurationSeconds 6,
#                  CooldownSeconds 30, FormCheckMs 250
#

SodDruid.KingOfTheJungle.DamagePct = 15
SodDruid.KingOfTheJungle.Energy = 60
SodDruid.KingOfTheJungle.BuffDurationSeconds = 6
SodDruid.KingOfTheJungle.CooldownSeconds = 30
SodDruid.KingOfTheJungle.FormCheckMs = 250

#
#    SodDruid.SkullBash.*
#        EnergyCost and RageCost tune the Cat and Bear form costs. Rage is configured
#        in whole points. SchoolLockoutSeconds controls the interrupted school's lockout.
#        Defaults: EnergyCost 25, RageCost 10, SchoolLockoutSeconds 2
#

SodDruid.SkullBash.EnergyCost = 25
SodDruid.SkullBash.RageCost = 10
SodDruid.SkullBash.SchoolLockoutSeconds = 2

#
#    SodDruid.ImprovedFrenziedRegeneration.*
#        RagePerSecond, EnergyPerSecond, and BaseManaPctPerSecond tune resource conversion.
#        HealthPctPerSecond is the maximum health restored for the full resource amount.
#        Rage is configured in whole points and stored internally in tenths.
#        Defaults: RagePerSecond 10, EnergyPerSecond 10, BaseManaPctPerSecond 20,
#                  HealthPctPerSecond 10
#

SodDruid.ImprovedFrenziedRegeneration.RagePerSecond = 10
SodDruid.ImprovedFrenziedRegeneration.EnergyPerSecond = 10
SodDruid.ImprovedFrenziedRegeneration.BaseManaPctPerSecond = 20
SodDruid.ImprovedFrenziedRegeneration.HealthPctPerSecond = 10

#
#    SodDruid.ImprovedSwipe.MaxBearTargets
#        Maximum number of enemies Bear Form Swipe can hit with the rune active.
#        SoD allows the primary target plus 7 additional enemies.
#        Default: 8
#

SodDruid.ImprovedSwipe.MaxBearTargets = 8

#
#    SodDruid.GaleWinds.*
#        DamagePct increases Hurricane damage; ManaCostReductionPct reduces its cost.
#        Hurricane's cooldown is removed while the rune is active.
#        Defaults: DamagePct 20, ManaCostReductionPct 30
#

SodDruid.GaleWinds.DamagePct = 20
SodDruid.GaleWinds.ManaCostReductionPct = 30

#
#    SodDruid.FuryOfStormrage.*
#        Wrath's mana cost reduction, proc chance, and instant Healing Touch duration.
#        Defaults: 100%, 12%, 15 seconds
#

SodDruid.FuryOfStormrage.WrathCostReductionPct = 100
SodDruid.FuryOfStormrage.ProcChance = 12
SodDruid.FuryOfStormrage.BuffDurationSeconds = 15

#
#    SodDruid.Dreamstate.*
#        Mana regeneration while casting and the Arcane/Nature vulnerability duration.
#        Defaults: 50%, 8 seconds, 20%, 12 seconds
#

SodDruid.Dreamstate.ManaRegenPct = 50
SodDruid.Dreamstate.ManaRegenDurationSeconds = 8
SodDruid.Dreamstate.DamageTakenPct = 20
SodDruid.Dreamstate.DamageTakenDurationSeconds = 12

#
#    SodDruid.TreeOfLife.*
#        Passive approximation of Tree Form; party healing aura refresh and rune SpellMods.
#        Defaults: 45 yards, 2 seconds, 1 second, 20%, 60%
#

SodDruid.TreeOfLife.PartyRadiusYards = 45
SodDruid.TreeOfLife.PartyBuffDurationMs = 2000
SodDruid.TreeOfLife.PartyRefreshMs = 1000
SodDruid.TreeOfLife.HotManaCostReductionPct = 20
SodDruid.TreeOfLife.WildGrowthHealingPct = 60

###############################################################################
# SHAMAN
###############################################################################
#
#    SodShaman.Enable
#        Descripción: interruptor para los scripts propios de runas del chamán.
#                     Los clones que usan el comportamiento nativo del core no lo consultan.
#        Valor predeterminado: 1 - (Activado)
#                              0 - (Desactivado)
#

SodShaman.Enable = 1

###############################################################################
# HUNTER
###############################################################################
#
#    SodHunter.Enable
#        Descripción: interruptor para los scripts propios de runas del cazador.
#                     Los clones que usan el comportamiento nativo del core no lo consultan.
#        Valor predeterminado: 1 - (Activado)
#                              0 - (Desactivado)
#

SodHunter.Enable = 1

###############################################################################
# PALADIN
###############################################################################
#
#    SodPaladin.Enable
#        Description: Master switch for custom Paladin rune scripts.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#

SodPaladin.Enable = 1

###############################################################################
# WARLOCK
###############################################################################
#
#    SodWarlock.Enable
#        Descripción: interruptor para los scripts propios de runas del brujo.
#                     Los clones que usan el comportamiento nativo del core no lo consultan.
#        Valor predeterminado: 1 - (Activado)
#                              0 - (Desactivado)
#

SodWarlock.Enable = 1

#
#    SodPaladin.ArtOfWar.*
#        ManaCostReductionPct changes Exorcism's spell-modifier discount.
#        CooldownReductionSeconds is removed from its remaining cooldown per melee crit.
#        Defaults: ManaCostReductionPct 80, CooldownReductionSeconds 2
#

SodPaladin.ArtOfWar.ManaCostReductionPct = 80
SodPaladin.ArtOfWar.CooldownReductionSeconds = 2

#
#    SodPaladin.RighteousVengeance.DamagePct
#        Percent of a qualifying critical strike added as periodic damage.
#        The duration and tick cadence come from WotLK spell 61840 (8 seconds).
#        Default: 30
#

SodPaladin.RighteousVengeance.DamagePct = 30

#
#    SodPaladin.ImprovedHammerOfWrath.ResetHealthPct
#        Hammer of Wrath resets its cooldown when it damages a target below this
#        health percentage. Set to 0 to disable the reset.
#        Default: 10
#

SodPaladin.ImprovedHammerOfWrath.ResetHealthPct = 10

#
#    SodPaladin.PurifyingPower.*
#        CooldownReductionPct is applied to Exorcism and Holy Wrath.
#        StunSeconds is the stun duration against Undead and Demon targets.
#        Defaults: CooldownReductionPct 50, StunSeconds 2
#

SodPaladin.PurifyingPower.CooldownReductionPct = 50
SodPaladin.PurifyingPower.StunSeconds = 2

#
#    SodPaladin.Fanaticism.*
#        HolyCritChancePct increases critical chance for Holy spells. HealingPct
#        is the portion of a critical heal repeated over the helper's 12s duration.
#        Defaults: HolyCritChancePct 18, HealingPct 60
#

SodPaladin.Fanaticism.HolyCritChancePct = 18
SodPaladin.Fanaticism.HealingPct = 60

#
#    SodPaladin.InfusionOfLight.*
#        DamageHealingPct aumenta el daño y la sanación de Choque Sagrado.
#        CriticalCooldownSeconds se resta del tiempo restante tras un crítico de
#        Choque Sagrado (que en WotLK ya tiene 6 s de enfriamiento, como en SoD).
#        Valores predeterminados: 50, 3
#

SodPaladin.InfusionOfLight.DamageHealingPct = 50
SodPaladin.InfusionOfLight.CriticalCooldownSeconds = 3

#
#    SodPaladin.Aegis.*
#        BlockValuePct aumenta el valor de bloqueo. RedoubtChancePct se aplica a
#        ataques cuerpo a cuerpo o a distancia recibidos. ReckoningChancePerPointPct
#        se multiplica por el rango aprendido de Expiación.
#        Valores predeterminados: 30, 10, 2
#

SodPaladin.Aegis.BlockValuePct = 30
SodPaladin.Aegis.RedoubtChancePct = 10
SodPaladin.Aegis.ReckoningChancePerPointPct = 2

#
#    SodPaladin.SheathOfLight.*
#        Porcentaje del poder de ataque convertido en daño con hechizos y duración.
#        Valores predeterminados: 30, 60 s
#

SodPaladin.SheathOfLight.AttackPowerPct = 30
SodPaladin.SheathOfLight.DurationSeconds = 60

#
#    SodPaladin.GuardedByTheLight.*
#        Maná máximo recuperado por pulso, intervalo, duración y reducción de sanación.
#        Valores predeterminados: 5 %, 3 s, 15 s, 50 %
#

SodPaladin.GuardedByTheLight.ManaPctPerTick = 5
SodPaladin.GuardedByTheLight.TickSeconds = 3
SodPaladin.GuardedByTheLight.DurationSeconds = 15
SodPaladin.GuardedByTheLight.HealingReductionPct = 50

#
#    SodPaladin.ShockAndAwe.*
#        Porcentaje del intelecto convertido en daño con hechizos, reducción de amenaza
#        y duración del beneficio.
#        Valores predeterminados: 200 %, 30 %, 60 s
#

SodPaladin.ShockAndAwe.IntellectSpellDamagePct = 200
SodPaladin.ShockAndAwe.ThreatReductionPct = 30
SodPaladin.ShockAndAwe.DurationSeconds = 60

#
#    SodPaladin.HallowedGround.HealingPct
#        Porcentaje del daño periódico de Consagración convertido en sanación al grupo.
#        Valor predeterminado: 200
#

SodPaladin.HallowedGround.HealingPct = 200

#
#    SodPaladin.BeaconOfLight.*
#        Porcentaje de transferencia de sanación y duración del aura.
#        Valores predeterminados: 75 %, 3600 s
#

SodPaladin.BeaconOfLight.HealingPct = 75
SodPaladin.BeaconOfLight.DurationSeconds = 3600

#
#    SodPaladin.DivineLight.*
#        Porcentaje de la sanación excesiva que crea el escudo y su duración.
#        Valores predeterminados: 50 %, 15 s
#

SodPaladin.DivineLight.OverhealShieldPct = 50
SodPaladin.DivineLight.ShieldDurationSeconds = 15

#
#    SodPaladin.SacredShield.*
#        Cooldown del escudo tras recibir daño, porcentaje del Destello de Luz
#        repetido como sanación periódica y duración de esa sanación.
#        Probabilidad crítica extra y duración también se pueden ajustar.
#        Valores predeterminados: 5 s, 100 %, 12 s, 50 %, 6 s
#

SodPaladin.SacredShield.CooldownSeconds = 5
SodPaladin.SacredShield.FlashOfLightHealPct = 100
SodPaladin.SacredShield.HotDurationSeconds = 12
SodPaladin.SacredShield.FlashOfLightCritPct = 50
SodPaladin.SacredShield.FlashOfLightCritSeconds = 6

#
#    SodPaladin.InspirationExemplar.*
#        Intervalo de disipación y radio de búsqueda para miembros del grupo.
#        El catálogo fija 4 s; el radio predeterminado de 10 yardas es aproximado.
#

SodPaladin.InspirationExemplar.IntervalSeconds = 4
SodPaladin.InspirationExemplar.RadiusYards = 10

#
#    SodPaladin.HandOfReckoning.*
#        Reembolso de maná y reducción del daño al cruzar el umbral de salud,
#        mientras Furia recta esté activa. WotLK ya aplica un 80 % de amenaza Sagrada.
#        Valores predeterminados: 25 %, umbral 35 %, reducción 20 %
#

SodPaladin.HandOfReckoning.ManaRestorePct = 25
SodPaladin.HandOfReckoning.DamageThresholdPct = 35
SodPaladin.HandOfReckoning.DamageReductionPct = 20

#
#    SodPaladin.MalleableProtection.*
#        Aumento de duración de Protección divina, poder de ataque por punto de
#        defensa sobre el valor base del nivel y duración de ese beneficio.
#        Valores predeterminados: 50 %, 4 AP, 5 de defensa por nivel, 15 s
#

SodPaladin.MalleableProtection.DurationIncreasePct = 50
SodPaladin.MalleableProtection.AttackPowerPerDefense = 4
SodPaladin.MalleableProtection.DefenseSkillPerLevel = 5
SodPaladin.MalleableProtection.AttackPowerDurationSeconds = 15

###############################################################################
# WARRIOR
###############################################################################
#
#    SodWarrior.Enable
#        Descripción: interruptor para los scripts propios de runas del guerrero.
#                     Los clones que usan el comportamiento nativo del core no lo consultan.
#        Valor predeterminado: 1 - (Activado)
#                              0 - (Desactivado)
#

SodWarrior.Enable = 1
